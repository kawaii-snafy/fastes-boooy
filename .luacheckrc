-- luacheck configuration for FastesBoooy (luacheck 1.1.2).
--
-- The custom std "forever" is built at load time from tools/data/forever_api.lua
-- (generated by tools/gen_forever_api.py from the Forever client's API dump), so
-- any call to a function / C_* namespace field / Enum value that does not exist in
-- the World of Warcraft: Forever client is reported:
--   * unknown global             -> W113 accessing undefined variable
--   * unknown C_X.Func / Enum.X  -> W143 accessing undefined field of a global
-- The std also models the WoW Lua environment: no io/os/require/dofile/package/debug.
--
-- luacheck evaluates this file as Lua 5.1 with dofile/io available; paths are
-- relative to the directory luacheck is started from (the repository root:
-- `make lint`, CI).

local API_FILE = "tools/data/forever_api.lua"

local function loadApi()
    local fh = io.open(API_FILE, "r")
    if not fh then return nil end
    fh:close()
    local ok, api = pcall(dofile, API_FILE)
    if ok and type(api) == "table" then return api end
    return nil
end

local api = loadApi()

local function fieldsOf(list, readOnly)
    local f = {}
    for _, name in ipairs(list or {}) do
        f[name] = readOnly == false and { read_only = false } or {}
    end
    return f
end

-- Lua 5.1 base library as present in the WoW client (functions + non-function members).
local LUA_BASE_EXTRA = { "_G", "_VERSION" }
local LUA_CONSTANT_FIELDS = { math = { "huge", "pi" } }

local function buildForeverStd()
    local rg = {}
    local function addPlain(list, def)
        for _, name in ipairs(list or {}) do
            if rg[name] == nil then rg[name] = def or {} end
        end
    end
    local OPEN = { other_fields = true }

    -- plain functions: C API, WoW Lua helpers (strsplit, wipe, tinsert...), FrameXML functions
    addPlain(api.globals)
    addPlain(api.luaGlobals)
    addPlain(api.frameXMLGlobals)
    addPlain(LUA_BASE_EXTRA)
    -- LE_* constants
    addPlain(api.leGlobals)

    -- Lua library tables with the WoW extensions (string.split, table.wipe, math.round, bit.band...)
    for lib, names in pairs(api.luaNamespaces or {}) do
        local f = fieldsOf(names)
        for _, c in ipairs(LUA_CONSTANT_FIELDS[lib] or {}) do f[c] = {} end
        rg[lib] = { fields = f }
    end

    -- C_* namespaces: closed field sets => misspelled / non-existent functions are reported
    for ns, names in pairs(api.namespaces or {}) do
        rg[ns] = { fields = fieldsOf(names) }
    end
    -- FrameXML *Util tables (functions dumped from the live client)
    for t, names in pairs(api.frameXMLTables or {}) do
        if rg[t] == nil then rg[t] = { fields = fieldsOf(names) } end
    end

    -- Enum.X.Y / Constants.X.Y: closed nested field sets
    local enumFields = {}
    for name, values in pairs(api.enums or {}) do
        local vf = {}
        for k in pairs(values) do vf[k] = {} end
        enumFields[name] = { fields = vf }
    end
    rg.Enum = { fields = enumFields }
    local constFields = {}
    for name, values in pairs(api.constants or {}) do
        local vf = {}
        for k in pairs(values) do vf[k] = {} end
        constFields[name] = { fields = vf }
    end
    rg.Constants = { fields = constFields }

    -- FrameXML function-library tables with enumerated members (Settings, UiMapPoint, ...):
    -- closed top level => Settings.RegisterBogusCategory is reported; members stay open
    -- (their own shape is not enumerated)
    for t, names in pairs(api.frameXMLExtraTables or {}) do
        if rg[t] == nil then
            local f = {}
            for _, name in ipairs(names) do f[name] = OPEN end
            rg[t] = { fields = f }
        end
    end

    -- global objects/tables whose members are not enumerated: allow any field
    addPlain(api.frameXMLExtraGlobals, OPEN)   -- SlashCmdList, RAID_CLASS_COLORS, Minimap, ...
    addPlain(api.uiColorGlobals, OPEN)         -- NORMAL_FONT_COLOR, ...
    addPlain(api.frames, OPEN)                 -- UIParent, GameTooltip, WorldMapFrame, ...
    addPlain(api.fonts, OPEN)                  -- GameFontNormal, ...
    addPlain(api.mixins, OPEN)                 -- BackdropTemplateMixin, CallbackRegistryMixin, ...

    -- The addon registers exactly one slash command handler.
    rg.SlashCmdList = { other_fields = true, fields = { FASTESBOOOY = { read_only = false } } }

    return { read_globals = rg }
end

stds = stds or {}
if api then
    stds.forever = buildForeverStd()
else
    io.stderr:write("luacheckrc: " .. API_FILE .. " not found; run `make api`. Falling back to lua51.\n")
    stds.forever = { read_globals = {} }
end

-- Globals the core addon may define / write.
stds.fastesboooy = {
    globals = {
        "FastesBoooy", "FastesBoooyDB", "FastesBoooyCharDB",
        "SLASH_FASTESBOOOY1", "SLASH_FASTESBOOOY2",
    },
}

-- Route modules may only READ the registration API of the core.
stds.fastesboooy_route = {
    read_globals = {
        FastesBoooy = {
            fields = { RegisterRoute = {}, AddSegment = {}, AddRouteData = {} },
        },
    },
}

std = "lua51"
max_line_length = 140
codes = true

exclude_files = {
    "tools/data/**",
    "dist/**",
    ".cache/**",
    ".git/**",
}

-- Core addon: WoW environment only (no lua51 io/os/require...).
files["addons/FastesBoooy/**/*.lua"] = {
    std = "forever+fastesboooy",
}

-- Route modules (content-only addons): nothing but FastesBoooy.RegisterRoute/AddSegment/AddRouteData.
files["addons/FastesBoooy_*/**/*.lua"] = {
    std = "fastesboooy_route",
}

-- Offline tools: plain Lua 5.1 CLI scripts.
files["tools/**/*.lua"] = {
    std = "lua51",
}

-- Specs, the WoW API mock and the test helpers run under busted; the mock installs
-- WoW globals. (Only these paths get the relaxed rules: route-module fixtures below must
-- not inherit them -- luacheck merges every matching `files` block.)
local TEST_CODE = {
    std = "lua51+busted",
    allow_defined = true,
    allow_defined_top = true,
    ignore = {
        "111", -- setting non-standard global (mocks install WoW API globals)
        "112", -- mutating non-standard global
        "113", -- accessing undefined variable (WoW API globals provided by the mock)
        "122", -- setting read-only field of global (stubbing os/io functions in specs)
        "143", -- accessing undefined field of a global
        "212", -- unused argument (mock signatures mirror the real API)
    },
}
files["tests/spec/**/*.lua"] = TEST_CODE
files["tests/mocks/**/*.lua"] = TEST_CODE
files["tests/fixtures/core/helpers.lua"] = TEST_CODE
-- Generated data tables of the WoW API mock (one entry per line, can be long).
files["tests/mocks/wow/signatures.lua"] = {
    max_line_length = false,
}
-- Test fixtures are route modules (content-only addons): exactly the rules of
-- addons/FastesBoooy_*/ (std fastesboooy_route, no ignores).
files["tests/fixtures/FastesBoooy_*/**/*.lua"] = {
    std = "fastesboooy_route",
}
files["tests/fixtures/*/FastesBoooy_*/**/*.lua"] = {
    std = "fastesboooy_route",
}
